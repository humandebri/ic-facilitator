{
  "name": "ic-facilitator",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && npm run build:facilitator",
    "build:facilitator": "cargo build -p jpyc_x402_facilitator --release --target wasm32-unknown-unknown",
    "clean:build": "scripts/clean_build_artifacts.sh --yes",
    "doctor": "tsx scripts/doctor.ts",
    "ic:clean:local": "scripts/clean_local_ic.sh --yes",
    "ic:deploy:local": "icp deploy edge --yes",
    "ic:deploy:mainnet": "icp deploy -e ic edge --yes",
    "ic:env:local": "scripts/set_canister_env.sh local",
    "ic:env:mainnet": "scripts/set_canister_env.sh ic",
    "pay:jpyc": "tsx scripts/pay_jpyc.ts",
    "receipt:settlement": "tsx scripts/settlement_receipt.ts",
    "readiness:jpyc": "tsx scripts/readiness.ts",
    "smoke:canister": "tsx scripts/smoke_canister.ts",
    "smoke:canister:env": "tsx scripts/smoke_canister_env.ts",
    "smoke:canister:paid-negative": "tsx scripts/smoke_canister_paid_negative.ts",
    "verify:jpyc": "tsx scripts/readiness.ts --with-canister-env-smoke --with-canister-smoke --with-paid-negative-smoke --with-wallet --with-settlement-receipt",
    "wallet:env": "tsx scripts/evm_wallet.ts --env",
    "wallet:new": "tsx scripts/evm_wallet.ts",
    "wallet:jpyc": "tsx scripts/jpyc_wallet.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@x402/core": "2.13.0",
    "@x402/evm": "2.13.0",
    "viem": "2.50.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
